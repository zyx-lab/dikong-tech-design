{
  "project": "dikong-tech-design",
  "modes": [
    "development",
    "search"
  ],
  "permission_case_constraints": {
    "description": "Use permission APIs only for create user and assign business roles.",
    "allowed_ops": [
      {
        "path_pattern": "^/internal/auth/users/?$",
        "method": "POST",
        "purpose": "create_user"
      },
      {
        "path_pattern": "^/internal/auth/staff-types/.+/groups/?$",
        "method": "POST",
        "purpose": "assign_business_role"
      }
    ]
  },
  "required_status_coverage": [
    {
      "code": 200,
      "name": "success"
    },
    {
      "code": 400,
      "name": "invalid_params"
    },
    {
      "code": 401,
      "name": "unauthenticated"
    },
    {
      "code": 403,
      "name": "forbidden"
    },
    {
      "code": 404,
      "name": "not_found"
    },
    {
      "code": 409,
      "name": "state_conflict_or_idempotency"
    }
  ]
}