// ============================================================
// 航点内部存储 Schema
// 数据库：PostgreSQL
// 文档类型：图表 (schema)
// ============================================================

// updated_at: 2026-03-31
// entity: waypoint
// 当前边界：waypoints 仅作为历史内部持久化结构
// 没有公开 API /api/v1/waypoints*
// 当前 route 写接口不再写入该表；DELETE /api/v1/routes/{id} 会清理残留行

Table waypoints [note: '历史 route 数据遗留的内部航点表'] {
  id bigint [pk, increment, note: 'ID']
  route_id bigint [not null, note: '所属 route ID']
  sequence integer [not null, note: '航点序号']
  latitude numeric(12,8) [not null, note: '纬度']
  longitude numeric(12,8) [not null, note: '经度']
  altitude numeric(10,2) [not null, note: '飞行高度（米）']
  created_at timestamp [not null, note: '创建时间']

  indexes {
    (route_id, sequence) [unique, name: 'waypoints_route_seq_unique']
  }
}
