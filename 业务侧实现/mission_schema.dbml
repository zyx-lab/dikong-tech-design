// updated_at: 2026-03-15T14:20:00+08:00
// entity: mission
// 历史保留 + 当前轮增补：当前轮新增 PUT / PATCH /api/v1/missions/{id}（更新）、POST /api/v1/missions/{id}/start（启动）、POST /api/v1/missions/{id}/pause（暂停）、POST /api/v1/missions/{id}/resume（恢复）与 POST /api/v1/missions/{id}/cancel（取消）
// 当前轮接口语义：
// 1) PUT / PATCH 按 mission 主键更新 name/route/drone/pilot/scheduled_at/remark
// 2) start 将 PENDING 流转到 RUNNING；RUNNING 重复 start 幂等成功，请求体必须为空
// 3) pause 将 RUNNING 流转到 PAUSED；PAUSED 重复 pause 幂等成功，请求体必须为空
// 4) resume 将 PAUSED 流转到 RUNNING；RUNNING 重复 resume 幂等成功，请求体必须为空
// 5) cancel 将 PENDING/RUNNING/PAUSED 流转到 CANCELED，请求体必须为空
// 当前轮业务码：00000 / A0401 / A0403 / B0001 / C0201 / C0404 / E0001

Table missions {
  id bigint [pk, increment, note: 'ID']
  tenant_id bigint [not null, note: '租户ID（FK: access.Tenant）']
  name varchar(100) [not null, note: '任务名称']
  route_id bigint [not null, note: '航线ID（FK: route.Route）']
  route_name varchar(100) [not null, note: '航线名称（冗余）']
  drone_id bigint [not null, note: '无人机ID（FK: drone.Drone）']
  drone_name varchar(100) [not null, note: '无人机名称（冗余）']
  pilot_id bigint [not null, note: '飞手成员ID（FK: access.TenantMember）']
  pilot_name varchar(50) [not null, note: '飞手姓名（冗余）']
  scheduled_at timestamp [note: '计划执行时间']
  remark varchar(500) [not null, note: '任务备注']
  status int [not null, note: '任务状态(0待执行/1执行中/2已暂停/3已完成/4已取消/5执行失败)']
  created_at timestamp [not null, note: '创建时间']
  updated_at timestamp [not null, note: '更新时间']
}

// pilot 字段语义：
// - 接口传入 / 返回的 pilot 都是 TenantMember.id
// - 仅允许绑定当前租户下 ACTIVE 且带 pilot_operator 的成员

// 本轮增补（2026-03-09）
// focus_api: POST /api/v1/missions/{id}/start
// start 语义：按 missions.id 启动单条任务，仅更新 status=RUNNING。
// 状态边界：仅允许 PENDING 启动；RUNNING 再次启动按 00000 处理；PAUSED/COMPLETED/CANCELED/FAILED 返回 C0201。
// 输入边界：start 请求不支持提交 body 参数，非空请求体返回 B0001。

// 本轮增补（2026-03-09）
// focus_api: POST /api/v1/missions/{id}/pause
// pause 语义：按 missions.id 暂停单条任务，仅更新 status=PAUSED。
// 状态边界：仅允许 RUNNING 暂停；PAUSED 再次暂停按 00000 处理；PENDING/COMPLETED/CANCELED/FAILED 返回 C0201。
// 输入边界：pause 请求不支持提交 body 参数，非空请求体返回 B0001。

// 本轮增补（2026-03-09）
// focus_api: POST /api/v1/missions/{id}/resume
// resume 语义：按 missions.id 恢复单条任务，仅更新 status=RUNNING。
// 状态边界：仅允许 PAUSED 恢复；RUNNING 再次恢复按 00000 处理；PENDING/COMPLETED/CANCELED/FAILED 返回 C0201。
// 输入边界：resume 请求不支持提交 body 参数，非空请求体返回 B0001。

// 本轮增补（2026-03-09）
// focus_api: POST /api/v1/missions/{id}/cancel
// cancel 语义：按 missions.id 取消单条任务，仅更新 status=CANCELED。
// 状态边界：仅允许 PENDING/RUNNING/PAUSED 取消；COMPLETED/CANCELED/FAILED 返回 C0201。
// 输入边界：cancel 请求不支持提交 body 参数，非空请求体返回 B0001。

