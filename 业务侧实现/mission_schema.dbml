// focus_api_keys: POST /api/v1/missions/{id}/fail
// business_events: EVT-001 失败任务
// required_codes: 00000, A0401, A0403, B0001, C0201, C0404, E0001
// permission_boundary: 代码权限码: view_mission (可查看任务), manage_mission (可新增与编辑任务)
// stage6_doc_sync::mission::schema.dbml::end
