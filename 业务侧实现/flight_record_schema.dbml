Table flight_records {
  id bigint [pk, increment, note: 'ID']
  flight_no varchar(50) [unique, not null, note: '架次编号']
  mission bigint [note: 'mission.Mission']
  mission_name varchar(100) [not null, note: '任务名称（冗余）']
  route_name varchar(100) [not null, note: '航线名称（冗余）']
  airport_name varchar(100) [not null, note: '执行机场名称']
  drone bigint [note: 'drone.Drone']
  drone_name varchar(100) [not null, note: '无人机名称（冗余）']
  pilot bigint [note: 'access.StaffProfile']
  pilot_name varchar(50) [not null, note: '飞手姓名（冗余）']
  start_time timestamp [note: '开始时间']
  end_time timestamp [note: '结束时间']
  flight_duration text [note: '飞行时长（秒）']
  photo_count text [not null, note: '拍摄照片数量']
  video_count text [not null, note: '录制视频数量']
  status text [not null, note: '状态']
  created_at timestamp [not null, note: '创建时间']
  updated_at timestamp [not null, note: '更新时间']
}

