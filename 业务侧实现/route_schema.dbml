// ============================================================
// 航线 Schema
// 数据库：PostgreSQL
// 文档类型：图表 (schema)
// ============================================================

// updated_at: 2026-04-16
// entity: route
// 当前 API：
// - GET /api/v1/routes
// - POST /api/v1/routes
// - GET /api/v1/routes/{id}
// - PUT /api/v1/routes/{id}
// - GET /api/v1/routes/{id}/kmz
// - DELETE /api/v1/routes/{id}
// 当前设计不再使用 Route.status；DJI 绑定结果由 tenant_route_indexes 表达

Table routes [note: '租户内 route 主记录'] {
  id bigint [pk, increment, note: 'ID']
  tenant_id bigint [not null, note: '所属租户']
  name varchar(100) [not null, note: '航线名称']
  created_at timestamp [not null, note: '创建时间']
  updated_at timestamp [not null, note: '更新时间']
}

Table tenant_route_indexes [note: 'route 与 DJI 航线的最小发布映射'] {
  id bigint [pk, increment, note: 'ID']
  tenant_id bigint [not null, note: '所属租户']
  route_id bigint [not null, unique, note: '业务 route']
  dji_wayline_id varchar(128) [not null, default: '', note: '当前绑定的 DJI 航线 ID']
  download_url varchar(500) [not null, default: '', note: '当前 DJI 航线下载地址']
  is_published boolean [not null, default: false, note: '当前 route 是否已绑定最近一次成功上传的 DJI 航线']
  created_at timestamp [not null, note: '创建时间']
  updated_at timestamp [not null, note: '更新时间']

  indexes {
    (tenant_id, dji_wayline_id) [name: 'uniq_tenant_dji_wayline_id']
  }
}
