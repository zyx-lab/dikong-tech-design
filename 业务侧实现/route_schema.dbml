// updated_at: 2026-03-08T07:52:00Z
// entity: route
// 历史保留 + 本轮增补：当前轮新增 PATCH /api/v1/routes/{id}，不改 routes 表结构
// 当前轮接口语义：按 route 主键局部更新主记录元数据，返回 SUCCESS / INVALID_PARAMS / PERMISSION_DENIED / RESOURCE_NOT_FOUND

Table routes {
  id bigint [pk, increment, note: 'ID']
  name varchar(100) [not null, note: '航线名称']
  route_type int [not null, note: '航线类型扩展位(0=待扩展)']
  drone_type_id bigint [note: '适用无人机类型 ID']
  total_distance decimal(12,2) [note: '航线总长度(米)']
  estimated_duration int [note: '预计飞行时长(秒)']
  waypoint_count int [note: '航点数量']
  creator_name varchar(50) [not null, note: '创建人姓名']
  status int [not null, note: '状态(0=禁用,1=正常)']
  created_at timestamp [not null, note: '创建时间']
  updated_at timestamp [not null, note: '更新时间']
}

