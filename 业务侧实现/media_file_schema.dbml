// generated_at: 2026-03-08T11:18:06.896282Z
// entity: media_file

Table media_files {
  id bigint [pk, increment, note: 'ID']
  flight_record bigint [note: 'flight_record.FlightRecord']
  media_type text [not null, note: '媒体类型']
  file_name varchar(255) [not null, note: '文件名']
  file_url varchar(500) [not null, note: '文件URL']
  thumbnail_url varchar(500) [not null, note: '缩略图URL']
  file_size bigint [note: '文件大小（字节）']
  latitude text [note: '拍摄位置-纬度']
  longitude text [note: '拍摄位置-经度']
  captured_at timestamp [note: '拍摄时间']
  is_deleted boolean [not null, note: '是否已删除']
  deleted_at timestamp [note: '删除时间']
  created_at timestamp [not null, note: '创建时间']
}

// 本轮增补（2026-03-08）
// focus_api: GET /api/v1/media-files/{id}
// retrieve 语义：按 media_files.id 读取单条详情；is_deleted=true 记录按 C0404 返回。
// 权限语义：需具备 media_file.view_media_file；未认证/无权限返回 A0401 / A0403。
// 说明：本轮仅补对象级读取语义，不引入新的数据表字段。

// 本轮增补（2026-03-08，迭代16）
// focus_api: DELETE /api/v1/media-files/{id}
// destroy 语义：按 media_files.id 执行逻辑删除，更新 is_deleted=true 与 deleted_at。
// 权限语义：需具备 media_file.manage_media_file；未认证/无权限返回 A0401 / A0403。
// 返回语义：00000=删除成功；C0404=记录不存在或已删除。






// 本轮增补（2026-03-08，迭代17）
// focus_api: POST /api/v1/media-files
// create 语义：写入 media_files 新记录；flight_record 可选绑定。
// 默认值语义：新建记录固定 is_deleted=false，deleted_at=null。
// 权限语义：需具备 media_file.manage_media_file；无权限返回 A0403。
// 业务码语义：00000=成功；B0001=参数错误；A0401/A0403=未认证或越权。

// 本轮增补（2026-03-09）
// focus_api: PUT / PATCH /api/v1/media-files/{id}
// update 语义：按 media_files.id 更新媒体元数据，仅允许白名单字段写入。
// 边界语义：空请求体返回 B0001；is_deleted=true 记录按 C0404 处理。
// 审计语义：成功更新后写入 MEDIA_FILE_UPDATE，保存 before/after 快照。
// 权限语义：需具备 media_file.manage_media_file；未认证/无权限返回 A0401 / A0403。

