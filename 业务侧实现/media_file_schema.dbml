// ============================================================
// 媒体文件 Schema
// 数据库：PostgreSQL
// 文档类型：图表 (schema)
// ============================================================

// updated_at: 2026-03-31
// entity: media_file
// 当前 API：
// - GET /api/v1/media-files
// - GET /api/v1/media-files/{id}
// - GET /api/v1/media-files/{id}/download
// 当前实现不再公开 POST / PUT / PATCH / DELETE /api/v1/media-files*

Table media_files [note: '媒体读模型主表'] {
  id bigint [pk, increment, note: 'ID']
  tenant_id bigint [not null, note: '所属租户']
  flight_record_id bigint [note: '关联飞行记录']
  media_type integer [not null, note: '媒体类型']
  file_name varchar(255) [not null, note: '文件名']
  file_url varchar(500) [not null, note: '内部文件 URL 占位']
  thumbnail_url varchar(500) [not null, default: '', note: '缩略图 URL']
  file_size bigint [note: '文件大小（字节）']
  latitude numeric(12,8) [note: '拍摄位置纬度']
  longitude numeric(12,8) [note: '拍摄位置经度']
  captured_at timestamp [note: '拍摄时间']
  is_deleted boolean [not null, default: false, note: '是否逻辑删除']
  deleted_at timestamp [note: '删除时间']
  created_at timestamp [not null, note: '创建时间']
}

Table tenant_media_indexes [note: 'media_file 与 DJI 文件的同步索引'] {
  id bigint [pk, increment, note: 'ID']
  tenant_id bigint [not null, note: '所属租户']
  media_file_id bigint [not null, unique, note: '业务媒体文件']
  dji_file_id varchar(128) [not null, note: 'DJI 文件 ID']
  device_sn varchar(128) [not null, default: '', note: '设备序列号']
  mission_id bigint [note: '关联任务 ID']
  sync_status varchar(32) [not null, default: 'PENDING', note: '同步状态']
  last_sync_at timestamp [note: '最近同步时间']
  error_msg varchar(255) [not null, default: '', note: '同步错误']
  created_at timestamp [not null, note: '创建时间']
  updated_at timestamp [not null, note: '更新时间']

  indexes {
    (tenant_id, dji_file_id) [unique, name: 'uniq_tenant_dji_file_id']
  }
}
