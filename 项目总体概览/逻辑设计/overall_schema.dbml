// ============================================================
// 低空平台 - 数据库Schema (DBML)
// 数据库：PostgreSQL
// 说明：对齐当前正式 /api/v1/* 实现，覆盖 Formal IAM Plane + Business API Plane
// ============================================================

Project low_altitude_platform {
  database_type: 'PostgreSQL'
  Note: '低空平台正式 API 当前实现模型总览'
}

// ============================================================
// 1. auth_users 账号表
// ============================================================
Table auth_users [note: '平台登录账号主体'] {
  id bigserial [pk, note: 'id 账号ID']
  username varchar(150) [not null, unique, note: 'username 登录账号']
  is_staff boolean [not null, default: false, note: 'is_staff 是否可登录 Django Admin']
  is_active boolean [not null, default: true, note: 'is_active Django 账户启用状态']
  is_superuser boolean [not null, default: false, note: 'is_superuser 技术 Root']
  is_platform_admin boolean [not null, default: false, note: 'is_platform_admin 是否平台工作态账号']
  status smallint [not null, default: 1, note: 'status 业务账号状态']
  last_login timestamp [note: 'last_login 最近登录时间']
  created_at timestamp [not null, default: `now()`, note: 'created_at 创建时间']
  updated_at timestamp [not null, default: `now()`, note: 'updated_at 更新时间']
}

// ============================================================
// 2. auth_sessions 认证会话表
// ============================================================
Table auth_sessions [note: '正式 Bearer Token 会话'] {
  id bigserial [pk, note: 'id 会话ID']
  user_id bigint [not null, ref: > auth_users.id, note: 'user_id 关联账号ID']
  session_type varchar(16) [not null, note: 'session_type BUSINESS / PLATFORM']
  access_token_hash varchar(64) [not null, unique, note: 'access_token_hash access token 哈希']
  refresh_token_hash varchar(64) [not null, unique, note: 'refresh_token_hash refresh token 哈希']
  access_token_expires_at timestamp [not null, note: 'access_token_expires_at access token 过期时间']
  refresh_token_expires_at timestamp [not null, note: 'refresh_token_expires_at refresh token 过期时间']
  revoked_at timestamp [note: 'revoked_at 撤销时间']
  last_refreshed_at timestamp [note: 'last_refreshed_at 最近刷新时间']
  last_used_at timestamp [note: 'last_used_at 最近使用时间']
  created_ip varchar(64) [note: 'created_ip 创建IP']
  last_used_ip varchar(64) [note: 'last_used_ip 最近使用IP']
  user_agent varchar(255) [not null, default: '', note: 'user_agent 客户端标识']
  created_at timestamp [not null, default: `now()`, note: 'created_at 创建时间']
  updated_at timestamp [not null, default: `now()`, note: 'updated_at 更新时间']
}

// ============================================================
// 3. staff_profiles 人员档案表
// ============================================================
Table staff_profiles [note: '账号绑定的全局人员档案'] {
  id bigserial [pk, note: 'id 人员档案ID']
  user_id bigint [not null, unique, ref: > auth_users.id, note: 'user_id 关联账号ID（1:1）']
  name varchar(64) [not null, note: 'name 姓名']
  phone varchar(32) [note: 'phone 手机号']
  email varchar(254) [note: 'email 邮箱']
  employment_status smallint [not null, default: 1, note: 'employment_status 在职状态']
  org_id bigint [note: 'org_id 组织ID']
  created_at timestamp [not null, default: `now()`, note: 'created_at 创建时间']
  updated_at timestamp [not null, default: `now()`, note: 'updated_at 更新时间']
}

// ============================================================
// 4. tenants 租户表
// ============================================================
Table tenants [note: '平台治理的租户主实体'] {
  id bigserial [pk, note: 'id 租户ID']
  code varchar(64) [not null, unique, note: 'code 租户编码']
  name varchar(128) [not null, note: 'name 租户名称']
  status smallint [not null, default: 1, note: 'status 租户状态']
  plan varchar(64) [not null, default: '', note: 'plan 套餐']
  remark varchar(500) [not null, default: '', note: 'remark 备注']
  created_at timestamp [not null, default: `now()`, note: 'created_at 创建时间']
  updated_at timestamp [not null, default: `now()`, note: 'updated_at 更新时间']
}

// ============================================================
// 5. roles 平台角色目录
// ============================================================
Table roles [note: '平台统一角色目录'] {
  id bigserial [pk, note: 'id 角色ID']
  code varchar(64) [not null, unique, note: 'code 角色编码']
  name varchar(128) [not null, note: 'name 角色名称']
  description varchar(500) [not null, default: '', note: 'description 角色描述']
  status smallint [not null, default: 1, note: 'status 目录状态']
  created_at timestamp [not null, default: `now()`, note: 'created_at 创建时间']
  updated_at timestamp [not null, default: `now()`, note: 'updated_at 更新时间']
}

// ============================================================
// 6. permissions 平台权限目录
// ============================================================
Table permissions [note: '正式授权使用的权限目录'] {
  id bigserial [pk, note: 'id 权限ID']
  code varchar(128) [not null, unique, note: 'code 权限编码']
  name varchar(128) [not null, note: 'name 权限名称']
  module varchar(64) [not null, note: 'module 模块名']
  resource_code varchar(64) [not null, default: '', note: 'resource_code 资源编码']
  description varchar(500) [not null, default: '', note: 'description 描述']
  status smallint [not null, default: 1, note: 'status 目录状态']
  created_at timestamp [not null, default: `now()`, note: 'created_at 创建时间']
  updated_at timestamp [not null, default: `now()`, note: 'updated_at 更新时间']

  indexes {
    (module, status) [name: 'idx_permission_module_status']
  }
}

// ============================================================
// 7. role_permission_grants 角色权限映射
// ============================================================
Table role_permission_grants [note: '角色到权限与 scope 的基线映射'] {
  id bigserial [pk, note: 'id 映射ID']
  role_id bigint [not null, ref: > roles.id, note: 'role_id 角色ID']
  permission_id bigint [not null, ref: > permissions.id, note: 'permission_id 权限ID']
  scope_type varchar(16) [not null, default: 'ALL', note: 'scope_type ALL / OWN / ASSIGNED']
  created_at timestamp [not null, default: `now()`, note: 'created_at 创建时间']
  updated_at timestamp [not null, default: `now()`, note: 'updated_at 更新时间']

  indexes {
    (role_id, permission_id) [unique, name: 'uniq_role_permission_grant']
  }
}

// ============================================================
// 8. qualification_types 资质类型表
// ============================================================
Table qualification_types [note: '平台统一资质类型字典'] {
  id bigserial [pk, note: 'id 资质类型ID']
  code varchar(64) [not null, unique, note: 'code 资质编码']
  name varchar(128) [not null, note: 'name 资质名称']
  description varchar(500) [not null, default: '', note: 'description 资质描述']
  requires_validity boolean [not null, default: false, note: 'requires_validity 是否要求有效期']
  payload_schema_json json [note: 'payload_schema_json 扩展字段schema']
  status smallint [not null, default: 1, note: 'status 目录状态']
  created_at timestamp [not null, default: `now()`, note: 'created_at 创建时间']
  updated_at timestamp [not null, default: `now()`, note: 'updated_at 更新时间']
}

// ============================================================
// 9. tenant_members 租户成员关系
// ============================================================
Table tenant_members [note: '账号进入租户后的成员主体'] {
  id bigserial [pk, note: 'id 成员关系ID']
  tenant_id bigint [not null, ref: > tenants.id, note: 'tenant_id 所属租户']
  user_id bigint [not null, ref: > auth_users.id, note: 'user_id 账号ID']
  member_no varchar(64) [note: 'member_no 租户内工号']
  display_name varchar(128) [not null, default: '', note: 'display_name 显示名称']
  invitation_token varchar(64) [note: 'invitation_token 邀请令牌']
  invited_by_user_id bigint [ref: > auth_users.id, note: 'invited_by_user_id 邀请人账号ID']
  invited_at timestamp [note: 'invited_at 邀请时间']
  expires_at timestamp [note: 'expires_at 过期时间']
  responded_at timestamp [note: 'responded_at 响应时间']
  joined_at timestamp [note: 'joined_at 加入时间']
  status smallint [not null, default: 0, note: 'status INVITED / ACTIVE / REJECTED / EXPIRED / REVOKED / DISABLED']
  created_at timestamp [not null, default: `now()`, note: 'created_at 创建时间']
  updated_at timestamp [not null, default: `now()`, note: 'updated_at 更新时间']

  indexes {
    (tenant_id, user_id) [unique, name: 'uniq_tenant_user_member']
    (tenant_id, member_no) [name: 'uniq_tenant_member_no']
    (invitation_token) [name: 'uniq_tenant_member_invitation_token']
  }
}

// ============================================================
// 10. tenant_member_roles 成员角色绑定
// ============================================================
Table tenant_member_roles [note: '租户成员与平台角色的绑定'] {
  id bigserial [pk, note: 'id 绑定ID']
  tenant_member_id bigint [not null, ref: > tenant_members.id, note: 'tenant_member_id 成员关系ID']
  system_role_id bigint [not null, ref: > roles.id, note: 'system_role_id 角色ID']
  status smallint [not null, default: 1, note: 'status GRANTED / REVOKED']
  assigned_by_user_id bigint [ref: > auth_users.id, note: 'assigned_by_user_id 分配人账号ID']
  assigned_at timestamp [note: 'assigned_at 分配时间']
  created_at timestamp [not null, default: `now()`, note: 'created_at 创建时间']
  updated_at timestamp [not null, default: `now()`, note: 'updated_at 更新时间']

  indexes {
    (tenant_member_id, system_role_id) [unique, name: 'uniq_member_role']
  }
}

// ============================================================
// 11. tenant_member_qualifications 成员资质记录
// ============================================================
Table tenant_member_qualifications [note: '租户成员资质信息'] {
  id bigserial [pk, note: 'id 资质记录ID']
  tenant_member_id bigint [not null, ref: > tenant_members.id, note: 'tenant_member_id 成员关系ID']
  qualification_type_id bigint [not null, ref: > qualification_types.id, note: 'qualification_type_id 资质类型ID']
  certificate_no varchar(128) [not null, default: '', note: 'certificate_no 证书编号']
  level varchar(64) [not null, default: '', note: 'level 等级']
  status smallint [not null, default: 1, note: 'status ACTIVE / INVALID / REVOKED']
  issued_at date [note: 'issued_at 发证日期']
  valid_from date [note: 'valid_from 有效开始日期']
  valid_until date [note: 'valid_until 有效截止日期']
  issuer varchar(128) [not null, default: '', note: 'issuer 发证机构']
  payload_json json [not null, note: 'payload_json 扩展信息']
  created_at timestamp [not null, default: `now()`, note: 'created_at 创建时间']
  updated_at timestamp [not null, default: `now()`, note: 'updated_at 更新时间']

  indexes {
    (tenant_member_id, qualification_type_id) [name: 'idx_tm_qualification_type']
    (tenant_member_id, status) [name: 'idx_tm_qualification_status']
  }
}

// ============================================================
// 12. auth_audit_logs 审计日志
// ============================================================
Table auth_audit_logs [note: '平台级 / 租户级关键动作审计'] {
  id bigserial [pk, note: 'id 日志ID']
  tenant_id bigint [ref: > tenants.id, note: 'tenant_id 所属租户']
  actor_user_id bigint [ref: > auth_users.id, note: 'actor_user_id 操作人账号ID']
  action varchar(128) [not null, note: 'action 动作码']
  target_type varchar(128) [not null, note: 'target_type 目标类型']
  target_id varchar(64) [not null, default: '', note: 'target_id 目标主键']
  before_data json [note: 'before_data 变更前快照']
  after_data json [note: 'after_data 变更后快照']
  ip varchar(39) [note: 'ip 请求IP']
  request_id varchar(64) [not null, default: '', note: 'request_id 请求追踪ID']
  created_at timestamp [not null, default: `now()`, note: 'created_at 创建时间']
}

// ============================================================
// 13. drones 无人机表
// ============================================================
Table drones [note: '租户内无人机台账'] {
  id bigserial [pk, note: 'id 无人机ID']
  tenant_id bigint [not null, ref: > tenants.id, note: 'tenant_id 所属租户']
  code varchar(64) [not null, note: 'code 租户内业务编码']
  name varchar(128) [not null, note: 'name 无人机名称']
  model varchar(128) [not null, note: 'model 型号']
  device_sn varchar(128) [not null, note: 'device_sn 设备序列号']
  status varchar(16) [not null, default: 'DISABLED', note: 'status ENABLED / DISABLED']
  org_id bigint [note: 'org_id 组织ID']
  created_by_tenant_member_id bigint [note: 'created_by_tenant_member_id 创建人 TenantMember ID']
  created_at timestamp [not null, default: `now()`, note: 'created_at 创建时间']
  updated_at timestamp [not null, default: `now()`, note: 'updated_at 更新时间']

  indexes {
    (tenant_id, code) [unique, name: 'uniq_drone_tenant_code']
    (tenant_id, device_sn) [unique, name: 'uniq_drone_tenant_device_sn']
  }
}

// ============================================================
// 14. drone_assignments 无人机分配表
// ============================================================
Table drone_assignments [note: '无人机与飞手成员的分配关系'] {
  id bigserial [pk, note: 'id 分配ID']
  tenant_id bigint [not null, ref: > tenants.id, note: 'tenant_id 所属租户']
  drone_id bigint [not null, ref: > drones.id, note: 'drone_id 无人机ID']
  tenant_member_id bigint [not null, ref: > tenant_members.id, note: 'tenant_member_id 飞手成员ID']
  status varchar(16) [not null, default: 'ACTIVE', note: 'status ACTIVE / INACTIVE']
  start_at timestamp [not null, default: `now()`, note: 'start_at 开始时间']
  end_at timestamp [note: 'end_at 结束时间']
  created_by_tenant_member_id bigint [note: 'created_by_tenant_member_id 创建人 TenantMember ID']
  created_at timestamp [not null, default: `now()`, note: 'created_at 创建时间']
  updated_at timestamp [not null, default: `now()`, note: 'updated_at 更新时间']
}

// ============================================================
// 15. routes 航线表
// ============================================================
Table routes [note: '租户内航线台账'] {
  id bigserial [pk, note: 'id 航线ID']
  tenant_id bigint [not null, ref: > tenants.id, note: 'tenant_id 所属租户']
  name varchar(100) [not null, note: 'name 航线名称']
  xml_file varchar(100) [not null, default: '', note: 'xml_file 本地 XML 草稿路径']
  created_at timestamp [not null, default: `now()`, note: 'created_at 创建时间']
  updated_at timestamp [not null, default: `now()`, note: 'updated_at 更新时间']
}

// ============================================================
// 16. waypoints 航点表
// ============================================================
Table waypoints [note: '历史航线数据遗留的内部航点表'] {
  id bigserial [pk, note: 'id 航点ID']
  route_id bigint [ref: > routes.id, not null, note: 'route_id 所属航线ID']
  sequence integer [not null, note: 'sequence 航点序号']
  latitude numeric(12,8) [not null, note: 'latitude 纬度']
  longitude numeric(12,8) [not null, note: 'longitude 经度']
  altitude numeric(10,2) [not null, note: 'altitude 飞行高度（米）']
  created_at timestamp [not null, default: `now()`, note: 'created_at 创建时间']

  indexes {
    (route_id, sequence) [unique, name: 'waypoints_route_seq_unique']
  }
}

// ============================================================
// 17. missions 任务表
// ============================================================
Table missions [note: '巡检任务主记录'] {
  id bigserial [pk, note: 'id 任务ID']
  tenant_id bigint [not null, ref: > tenants.id, note: 'tenant_id 所属租户']
  name varchar(100) [not null, note: 'name 任务名称']
  route_id bigint [ref: > routes.id, note: 'route_id 任务航线；route 删除后可为空']
  route_name varchar(100) [not null, default: '', note: 'route_name 航线名称（冗余）']
  drone_id bigint [not null, ref: > drones.id, note: 'drone_id 执行无人机']
  drone_name varchar(100) [not null, default: '', note: 'drone_name 无人机名称（冗余）']
  pilot_id bigint [not null, ref: > tenant_members.id, note: 'pilot_id 执行飞手成员']
  pilot_name varchar(50) [not null, default: '', note: 'pilot_name 飞手姓名（冗余）']
  scheduled_at timestamp [note: 'scheduled_at 计划执行时间']
  remark varchar(500) [not null, default: '', note: 'remark 任务备注']
  status smallint [not null, default: 0, note: 'status PENDING / RUNNING / PAUSED / COMPLETED / CANCELED / FAILED']
  dji_job_id varchar(128) [not null, default: '', note: 'dji_job_id DJI 任务 ID']
  created_at timestamp [not null, default: `now()`, note: 'created_at 创建时间']
  updated_at timestamp [not null, default: `now()`, note: 'updated_at 更新时间']
}

// ============================================================
// 18. flight_records 飞行记录表
// ============================================================
Table flight_records [note: '飞行执行过程记录'] {
  id bigserial [pk, note: 'id 记录ID']
  tenant_id bigint [not null, ref: > tenants.id, note: 'tenant_id 所属租户']
  flight_no varchar(50) [not null, note: 'flight_no 架次编号']
  mission_id bigint [ref: > missions.id, note: 'mission_id 所属任务']
  mission_name varchar(100) [not null, default: '', note: 'mission_name 任务名称（冗余）']
  route_name varchar(100) [not null, default: '', note: 'route_name 航线名称（冗余）']
  airport_name varchar(100) [not null, default: '', note: 'airport_name 执行机场名称']
  drone_id bigint [ref: > drones.id, note: 'drone_id 执行无人机']
  drone_name varchar(100) [not null, default: '', note: 'drone_name 无人机名称（冗余）']
  pilot_id bigint [ref: > tenant_members.id, note: 'pilot_id 执行飞手成员']
  pilot_name varchar(50) [not null, default: '', note: 'pilot_name 飞手姓名（冗余）']
  start_time timestamp [note: 'start_time 开始时间']
  end_time timestamp [note: 'end_time 结束时间']
  flight_duration integer [note: 'flight_duration 飞行时长（秒）']
  photo_count integer [not null, default: 0, note: 'photo_count 拍摄照片数量']
  video_count integer [not null, default: 0, note: 'video_count 录制视频数量']
  status smallint [not null, default: 0, note: 'status IN_PROGRESS / COMPLETED / ABORTED']
  created_at timestamp [not null, default: `now()`, note: 'created_at 创建时间']
  updated_at timestamp [not null, default: `now()`, note: 'updated_at 更新时间']

  indexes {
    (tenant_id, flight_no) [unique, name: 'uniq_flight_record_tenant_flight_no']
  }
}

// ============================================================
// 19. media_files 媒体文件表
// ============================================================
Table media_files [note: '飞行过程产生的图片与视频'] {
  id bigserial [pk, note: 'id 媒体ID']
  tenant_id bigint [not null, ref: > tenants.id, note: 'tenant_id 所属租户']
  flight_record_id bigint [ref: > flight_records.id, note: 'flight_record_id 关联飞行记录']
  media_type smallint [not null, note: 'media_type 1-照片, 2-视频']
  file_name varchar(255) [not null, note: 'file_name 文件名']
  file_url varchar(500) [not null, note: 'file_url 文件URL']
  thumbnail_url varchar(500) [not null, default: '', note: 'thumbnail_url 缩略图URL']
  file_size bigint [note: 'file_size 文件大小（字节）']
  latitude numeric(12,8) [note: 'latitude 拍摄位置纬度']
  longitude numeric(12,8) [note: 'longitude 拍摄位置经度']
  captured_at timestamp [note: 'captured_at 拍摄时间']
  is_deleted boolean [not null, default: false, note: 'is_deleted 是否逻辑删除']
  deleted_at timestamp [note: 'deleted_at 删除时间']
  created_at timestamp [not null, default: `now()`, note: 'created_at 创建时间']
}

// ============================================================
// 20. dji_workspace_configs DJI 工作空间配置表
// ============================================================
Table dji_workspace_configs [note: '系统托管的 DJI workspace / user 会话配置'] {
  id bigserial [pk, note: 'id 主键']
  workspace_id varchar(128) [not null, unique, note: 'workspace_id DJI workspace ID']
  dji_user_id varchar(128) [not null, default: '', note: 'dji_user_id DJI user ID']
  dji_username varchar(128) [not null, default: '', note: 'dji_username DJI 用户名']
  dji_user_type varchar(64) [not null, default: '', note: 'dji_user_type DJI 用户类型']
  access_token varchar(512) [not null, default: '', note: 'access_token 访问令牌']
  mqtt_username varchar(128) [not null, default: '', note: 'mqtt_username MQTT 用户名']
  mqtt_password varchar(256) [not null, default: '', note: 'mqtt_password MQTT 密码']
  mqtt_addr varchar(256) [not null, default: '', note: 'mqtt_addr MQTT 地址']
  expires_at timestamp [note: 'expires_at 访问令牌过期时间']
  created_at timestamp [not null, default: `now()`, note: 'created_at 创建时间']
  updated_at timestamp [not null, default: `now()`, note: 'updated_at 更新时间']
}

// ============================================================
// 21. dji_device_indexes DJI 设备索引表
// ============================================================
Table dji_device_indexes [note: '共享设备池快照'] {
  id bigserial [pk, note: 'id 主键']
  device_sn varchar(128) [not null, unique, note: 'device_sn 设备序列号']
  last_payload json [not null, default: '{}', note: 'last_payload 最近一次 DJI 原始载荷']
  last_seen_at timestamp [note: 'last_seen_at 最近见到时间']
  firmware_version varchar(128) [not null, default: '', note: 'firmware_version 固件版本']
  firmware_status varchar(64) [not null, default: '', note: 'firmware_status 固件状态']
  created_at timestamp [not null, default: `now()`, note: 'created_at 创建时间']
  updated_at timestamp [not null, default: `now()`, note: 'updated_at 更新时间']
}

// ============================================================
// 22. tenant_route_indexes 航线发布索引表
// ============================================================
Table tenant_route_indexes [note: 'route 与 DJI 航线的最小发布映射'] {
  id bigserial [pk, note: 'id 主键']
  tenant_id bigint [not null, ref: > tenants.id, note: 'tenant_id 所属租户']
  route_id bigint [not null, unique, ref: > routes.id, note: 'route_id 业务航线']
  dji_wayline_id varchar(128) [not null, default: '', note: 'dji_wayline_id DJI 航线 ID']
  is_published boolean [not null, default: false, note: 'is_published 当前本地草稿是否已发布']
  created_at timestamp [not null, default: `now()`, note: 'created_at 创建时间']
  updated_at timestamp [not null, default: `now()`, note: 'updated_at 更新时间']

  indexes {
    (tenant_id, dji_wayline_id) [name: 'uniq_tenant_dji_wayline_id']
  }
}

// ============================================================
// 23. tenant_mission_indexes 任务同步索引表
// ============================================================
Table tenant_mission_indexes [note: 'mission 与 DJI job 的一对一映射'] {
  id bigserial [pk, note: 'id 主键']
  tenant_id bigint [not null, ref: > tenants.id, note: 'tenant_id 所属租户']
  mission_id bigint [not null, unique, ref: > missions.id, note: 'mission_id 业务任务']
  dji_job_id varchar(128) [not null, note: 'dji_job_id DJI 任务 ID']
  execution_status varchar(64) [not null, default: '', note: 'execution_status 最近一次同步到的 DJI 状态原文']
  sync_status varchar(32) [not null, default: 'PENDING', note: 'sync_status 同步状态']
  last_sync_at timestamp [note: 'last_sync_at 最近同步时间']
  error_msg varchar(255) [not null, default: '', note: 'error_msg 同步错误']
  created_at timestamp [not null, default: `now()`, note: 'created_at 创建时间']
  updated_at timestamp [not null, default: `now()`, note: 'updated_at 更新时间']

  indexes {
    (tenant_id, dji_job_id) [unique, name: 'uniq_tenant_dji_job_id']
  }
}

// ============================================================
// 24. tenant_media_indexes 媒体同步索引表
// ============================================================
Table tenant_media_indexes [note: 'media_file 与 DJI 文件的一对一映射'] {
  id bigserial [pk, note: 'id 主键']
  tenant_id bigint [not null, ref: > tenants.id, note: 'tenant_id 所属租户']
  media_file_id bigint [not null, unique, ref: > media_files.id, note: 'media_file_id 业务媒体']
  dji_file_id varchar(128) [not null, note: 'dji_file_id DJI 文件 ID']
  device_sn varchar(128) [not null, default: '', note: 'device_sn 设备序列号']
  mission_id bigint [ref: > missions.id, note: 'mission_id 关联任务']
  sync_status varchar(32) [not null, default: 'PENDING', note: 'sync_status 同步状态']
  last_sync_at timestamp [note: 'last_sync_at 最近同步时间']
  error_msg varchar(255) [not null, default: '', note: 'error_msg 同步错误']
  created_at timestamp [not null, default: `now()`, note: 'created_at 创建时间']
  updated_at timestamp [not null, default: `now()`, note: 'updated_at 更新时间']

  indexes {
    (tenant_id, dji_file_id) [unique, name: 'uniq_tenant_dji_file_id']
  }
}
