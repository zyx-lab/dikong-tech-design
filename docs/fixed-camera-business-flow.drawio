        <mxCell id="10" value="管理员登记摄像头&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;WHEP / Results WS / 密钥&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E6F3ED;strokeColor=#4A8C70;fontSize=13;fontColor=#173B2C;" vertex="1" parent="1">
