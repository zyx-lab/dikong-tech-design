@startuml api_v2_internal
title api_v2 component - internal implementation
left to right direction
skinparam componentStyle rectangle

package "apps/api_v2" {
  component "apps.py\nregister system checks" as apps
  component "checks.py\nobject storage system checks" as checks
  component "urls.py\n/api/v2 route aggregator" as urls
  component "openapi.py\nshared schema serializers,\nlist_data_serializer" as openapi
  component "openapi_hooks.py\nstandard envelope hook,\nfrontend doc enrichment" as hooks
  component "docs_metadata.py\nfrontend guide text,\noperation summaries,\nexamples" as docs
}

apps --> checks
urls --> "iam_v2.urls" : include
urls --> "resource_v2.urls" : include
urls --> "inspection_v2.urls" : include
urls --> "system_v2.urls" : include
hooks --> docs
hooks --> openapi

@enduml
