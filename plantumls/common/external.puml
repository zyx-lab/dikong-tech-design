@startuml common_external
title common component - external interactions
left to right direction
skinparam componentStyle rectangle

component "apps/common" as common
component "apps/access\napi_base, exceptions" as access
component "apps/api_v2\nOpenAPI response hook" as api_v2
component "apps/iam_v2\nbusiness API views" as iam
component "apps/resource_v2\nbusiness API views" as resource
component "apps/inspection_v2\nbusiness API views" as inspection
component "apps/system_v2\nbusiness API views" as system
component "Django REST framework\nResponse, pagination" as drf

access --> common : strict API base,\nstandard errors
api_v2 --> common : envelope hook reads\nstandard response shape
iam --> common : BusinessApiResponseMixin,\nstandard_error_payload
resource --> common : BusinessApiResponseMixin,\nstandard_error_payload
inspection --> common : BusinessApiResponseMixin,\nstandard_error_payload
system --> common : BusinessApiResponseMixin,\nstandard_error_payload
common --> drf : wraps DRF responses\nand pagination

@enduml

