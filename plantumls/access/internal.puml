@startuml access_internal
title access component - internal implementation
left to right direction
skinparam componentStyle rectangle

package "apps/access" {
  component "apps.py\nAccessConfig.ready,\nregister openapi/signals" as access_apps
  component "models.py\nUser, AuthSession,\nTimeStampedModel" as access_models
  component "authentication.py\nBearerAuthSessionAuthentication,\nsha256_text" as access_auth
  component "openapi.py\nBearerAuthSessionAuthenticationScheme" as access_openapi
  component "session_services.py\ncreate/refresh/revoke sessions" as access_session_services
  component "session_serializers.py\nlogin/refresh/token serializers" as access_session_serializers
  component "session_views.py\nrefresh/logout endpoints" as access_session_views
  component "api_base.py\nStrictSerializer,\nV2 API base views" as access_api_base
  component "exceptions.py\nstandard DRF exception handler" as access_exceptions
  component "request_logging.py\nrequest id, payload redaction,\nrequest log helpers" as access_request_logging
  component "middleware.py\nrequest logging middleware" as access_middleware
  component "external_call_logging.py\nupstream call log lifecycle" as access_external_logging
  component "storage_backends.py\nLoggedS3Storage" as access_storage
  component "signals.py\nblock direct auth grants" as access_signals
  component "admin.py\nUser/AuthSession admin" as access_admin
}

access_apps --> access_openapi
access_apps --> access_signals
access_openapi ..> access_auth : target_class
access_session_views --> access_session_serializers
access_session_views --> access_session_services
access_session_views --> access_api_base : IamAPIView,\nensure_empty_body
access_session_services --> access_auth
access_session_services --> access_models
access_session_services --> access_exceptions : StandardUnauthorized
access_session_serializers --> access_api_base : StrictSerializer
access_auth --> access_models
access_api_base --> access_auth
access_api_base --> access_exceptions
access_exceptions --> access_request_logging
access_middleware --> access_request_logging
access_external_logging --> access_request_logging
access_storage --> access_external_logging
access_storage --> access_request_logging
access_signals --> access_models
access_admin --> access_models

@enduml
