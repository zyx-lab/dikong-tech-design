@startuml iam_v2_internal
title iam_v2 component - internal implementation
left to right direction
skinparam componentStyle rectangle

package "apps/iam_v2" {
  component "models.py\nV2Permission, V2Role,\nV2Menu, Department,\nV2AccountProfile,\nrole profiles, qualifications,\nResourceShareGroup" as models
  component "permissions.py\ncanonical permission,\nrole, menu specs" as permissions
  component "bootstrap.py\nsync permissions, roles,\nmenus, profile types,\ntest accounts" as bootstrap
  component "services.py\nV2RequestContext,\nrole permissions,\ndata scopes,\npermission checks" as services
  component "account_profile_services.py\nprofile type and\nrole profile helpers" as profile_services
  component "serializers.py\nIAM write/read serializers" as serializers
  component "profile_serializers.py\nlogin/me profile serializers" as profile_serializers
  component "profile_payloads.py\naccount summary payloads" as profile_payloads
  component "session_views.py\nV2 login endpoint" as session_views
  component "profile_views.py\ncurrent profile endpoint" as profile_views
  component "views.py\ndepartment, role,\npermission, account,\nqualification APIs" as views
  component "urls.py\nIAM API routes" as urls
  component "management/commands/bootstrap_v2_system.py" as bootstrap_cmd
}

permissions --> models : codes map to DB rows
bootstrap --> permissions
bootstrap --> models
services --> models
services --> permissions
profile_services --> models
serializers --> models
profile_serializers --> serializers
profile_payloads --> profile_services
profile_payloads --> serializers
profile_payloads --> services
session_views --> profile_payloads
session_views --> profile_serializers
session_views --> services
profile_views --> profile_payloads
profile_views --> profile_serializers
profile_views --> services
views --> bootstrap
views --> profile_services
views --> serializers
views --> services
urls --> session_views
urls --> profile_views
urls --> views
bootstrap_cmd --> bootstrap

@enduml

