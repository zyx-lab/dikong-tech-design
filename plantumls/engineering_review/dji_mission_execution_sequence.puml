@startuml dji_mission_execution_sequence
title DJI mission execution and media binding sequence
actor "Dispatcher / pilot" as Operator
participant "Inspection API" as InspectionApi
participant "Inspection service" as InspectionService
participant "Resource service" as ResourceService
database "Django DB" as DB
participant "DjiConnectionGateway" as ResourceGateway
participant "DjiGateway" as DjiGateway
cloud "DJI cloud" as DJI
participant "v2 DJI worker" as Worker
participant "Media callback endpoint" as Callback

Operator -> InspectionApi : start mission
InspectionApi -> InspectionService : start_mission(mission, context)
InspectionService -> InspectionService : build_mission_preflight_check()

alt preflight has blocking errors
  InspectionService --> InspectionApi : reject with reasons
  InspectionApi --> Operator : 409 standard error
else preflight passes
  InspectionService -> ResourceService : resolve active bindings
  ResourceService -> DB : read DjiConnection + resources
  InspectionService -> DB : create FlightSession
  InspectionService -> ResourceGateway : create upstream task / live
  ResourceGateway -> DjiGateway : call DJI protocol API
  DjiGateway -> DJI : HTTP request

  alt DJI accepts task
    DJI --> DjiGateway : job_id + accepted status
    DjiGateway --> ResourceGateway : upstream response
    ResourceGateway --> InspectionService : job_id
    InspectionService -> DB : create MissionCloudExecution\nstatus STARTING/RUNNING
    InspectionService --> InspectionApi : FlightSession
    InspectionApi --> Operator : mission running
  else DJI rejects or times out
    DjiGateway --> ResourceGateway : upstream error
    ResourceGateway --> InspectionService : gateway error
    InspectionService -> DB : keep mission pending or mark failed\naccording to service rule
    InspectionApi --> Operator : standard upstream error
  end
end

par status and telemetry
  DJI --> Worker : MQTT OSD/status event
  Worker -> InspectionService : apply_cloud_execution_event()\napply_osd_telemetry()
  InspectionService -> DB : update mission/session/execution/telemetry
else media callback
  DJI --> Callback : media-upload payload
  Callback -> InspectionService : handle_v2_media_upload_callback()
  InspectionService -> DB : upsert CloudMediaFile\nbind by job_id or session window
end

Operator -> InspectionApi : complete / close / safety abort
InspectionApi -> InspectionService : complete_mission() or safety_abort_mission()
InspectionService -> DB : finish session,\ncreate flight record,\nschedule media sync
InspectionApi --> Operator : final mission state + record

@enduml
