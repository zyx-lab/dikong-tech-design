@startuml dji_mock_internal
title dji_mock component - internal implementation
left to right direction
skinparam componentStyle rectangle

package "apps/dji_mock" {
  component "state.py\nMockDjiState\nin-memory workspace,\nuser, devices, jobs,\nmedia, live streams" as state
  component "views.py\nmock/protected decorators,\nlogin, devices, live,\npayload, wayline, jobs,\nmedia download endpoints" as views
  component "urls.py\nmock DJI API routes" as urls
  component "test_support.py\ntest helpers" as test_support
  component "tests.py\nmock endpoint tests" as tests
}

urls --> views
views --> state : reads and mutates\nmock_dji_state
test_support --> state
tests --> state
tests --> views

@enduml

