@startuml system_v2_internal
title system_v2 component - internal implementation
left to right direction
skinparam componentStyle rectangle

package "apps/system_v2" {
  component "urls.py\nsystem routes" as urls
  component "views.py\nSystemV2APIView,\nmenu tree helpers,\nmenu CRUD,\noperation/login/file log APIs" as views
}

urls --> views
views --> "CurrentMenuTreeView"
views --> "MenuTreeView"
views --> "MenuListCreateView"
views --> "MenuDetailView"
views --> "OperationLogListView"
views --> "LoginLogListView"
views --> "FileLogListView"

@enduml

