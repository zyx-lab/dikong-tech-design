@startuml system_v2_external
title system_v2 component - external interactions
left to right direction
skinparam componentStyle rectangle

component "apps/system_v2" as system
component "apps/access\nBearer auth,\nDirectoryStatus" as access
component "apps/common\nBusinessApiResponseMixin,\nStandardCode" as common
component "apps/api_v2\nOpenAPI list_data_serializer,\nroute aggregation" as api_v2
component "apps/iam_v2\nV2Menu, V2Permission,\nV2Role, serializers,\npermission context" as iam
component "apps/resource_v2\nV2AuditLog,\nAuditLogReadSerializer,\nlog_v2_action" as resource
database "Django DB\nIAM menu tables,\naudit logs" as db
actor "frontend/API client" as client

client --> system : /api/v2/system/*
api_v2 --> system : includes system URLs
system --> access : Bearer session auth,\nstatus enum
system --> common : standard response envelope
system --> iam : read/write menus,\npermissions, role grants;\nresolve context and data scope
system --> resource : write menu audit,\nread operation logs
system --> db : menu grants and audit rows

@enduml

