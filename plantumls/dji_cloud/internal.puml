@startuml dji_cloud_internal
title dji_cloud component - internal implementation
left to right direction
skinparam componentStyle rectangle

package "apps/dji_cloud" {
  component "gateway.py\nDjiGateway,\nDjiCloudSession,\nGatewayResponse,\nDjiGatewayError hierarchy" as gateway
  component "views.py\ninternal callback helpers,\nmedia_upload_callback,\nmedia_group_upload_callback" as views
  component "urls.py\ncallback routes" as urls
  component "test_gateway_logging.py\nexternal-call logging tests" as tests
}

urls --> views
views --> gateway : DjiGatewayError handling
gateway --> "external_call_logging.py" : started/finished/\nfailed/retry logs
gateway --> "request_logging.py" : payload redaction
tests --> gateway

@enduml

