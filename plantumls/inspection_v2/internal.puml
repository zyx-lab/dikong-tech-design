@startuml inspection_v2_internal
title inspection_v2 component - internal implementation
left to right direction
skinparam componentStyle rectangle

package "apps/inspection_v2" {
  component "models.py\nroutes, waypoints,\nmissions, assignments,\nflight sessions, telemetry,\ncloud execution, camera,\nrecords, media sync,\ncloud media files" as models
  component "route_kmz.py\nKMZ parse/build helpers" as route_kmz
  component "route_cover_images.py\nbase64/file cover validation" as route_cover
  component "serializers.py\nroute, mission, flight,\nmedia, live, camera serializers" as serializers
  component "services.py\npermissions, state transitions,\npreflight, live, media sync,\nDJI event handling,\ntelemetry handling" as services
  component "views.py\ninspection REST endpoints" as views
  component "urls.py\ninspection routes" as urls
  component "management/commands/run_v2_dji_worker.py\nMQTT worker,\nresource/media sync" as dji_worker
  component "management/commands/refresh_v2_flight_record_media.py" as media_refresh_cmd
  component "management/commands/refresh_route_kmz_download_urls.py" as kmz_refresh_cmd
  component "management/commands/migrate_route_covers_to_object_storage.py" as cover_migrate_cmd
}

serializers --> models
serializers --> route_cover
services --> models
services --> route_kmz
views --> serializers
views --> services
views --> route_kmz
urls --> views
dji_worker --> services : apply_osd_telemetry,\napply_device_status_event,\napply_cloud_execution_event,\nsync_due_flight_record_media
media_refresh_cmd --> services
kmz_refresh_cmd --> views : refresh download helper
kmz_refresh_cmd --> models
cover_migrate_cmd --> models

@enduml
