@startuml inspection_v2_external
title inspection_v2 component - external interactions
left to right direction
skinparam componentStyle rectangle

component "apps/inspection_v2" as inspection
component "apps/access\nAPI base, auth,\nexceptions, users" as access
component "apps/common\nresponse envelope" as common
component "apps/api_v2\nOpenAPI helpers,\nroute aggregation" as api_v2
component "apps/iam_v2\nDepartment, roles,\nprofiles, data scopes" as iam
component "apps/resource_v2\nbindings, resources,\nDjiConnectionGateway,\nMQTT helpers, audit" as resource
component "apps/dji_cloud.gateway\nDJI HTTP API" as dji_gateway
component "apps/dji_cloud.views\nmedia upload callbacks" as dji_callbacks
component "config/docker-compose\nrun_v2_dji_worker service" as runtime
database "Django DB\ninspection tables,\nresource links" as db
queue "DJI MQTT broker\nOSD/status/events" as mqtt_broker
cloud "DJI Cloud API\nwayline, jobs, live,\nmedia" as dji_cloud
cloud "S3/MinIO\nroute covers, KMZ,\nmedia URLs" as object_storage
actor "frontend/API client" as client

client --> inspection : /api/v2/inspection/*
api_v2 --> inspection : includes inspection URLs
inspection --> access : authenticated API base\nand exceptions
inspection --> common : standard response envelope
inspection --> iam : permission context,\nroles, departments
inspection --> resource : resource bindings,\nshare permissions,\nconnection gateway,\nMQTT telemetry helper,\naudit logs
inspection --> db : mission, flight,\nmedia persistence
inspection --> object_storage : cover/KMZ/media files\nand signed URLs
inspection --> dji_gateway : upstream route,\nmission, live, camera,\nmedia calls
dji_gateway --> dji_cloud : HTTP requests
dji_callbacks --> inspection : handle_v2_media_upload_callback
runtime --> inspection : starts worker command
inspection --> mqtt_broker : worker subscribes via\npaho.mqtt using connection credentials
mqtt_broker --> inspection : OSD/status/events\nprocessed by worker

@enduml

