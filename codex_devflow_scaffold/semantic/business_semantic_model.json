{
  "schema_version": 1,
  "business_goal": "低空业务 API 增量迭代",
  "roles": [
    "business_admin",
    "dispatcher",
    "pilot_operator",
    "auditor"
  ],
  "resources": [
    "drone",
    "drone_assignment"
  ],
  "actions": [
    "view",
    "create",
    "update",
    "change_status",
    "assign",
    "cancel_assignment"
  ],
  "state_machines": [
    {
      "resource": "drone",
      "states": [
        "ENABLED",
        "DISABLED",
        "MAINTENANCE",
        "RETIRED"
      ],
      "terminal_states": [
        "RETIRED"
      ]
    }
  ],
  "constraints": [
    "RETIRED 状态不可逆",
    "分配关系仅允许一条 ACTIVE 记录"
  ],
  "permission_boundary": {
    "model": "staff_type -> group -> permission(scope)",
    "scope_types": [
      "ALL",
      "OWN",
      "ASSIGNED"
    ]
  }
}
